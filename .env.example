# ---------------------------------------------------------------------------
# BBS — environment template. Committed with EMPTY values only.
# Copy to .env.local and fill in locally. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVER ONLY — never referenced from client code) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Google OAuth (configured in Supabase Auth dashboard) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Firebase Cloud Messaging (web push) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# SERVER ONLY
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Google Sheets (SERVER ONLY) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Operations ---
CRON_SECRET=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_WHATSAPP_ADMIN_NUMBER=

# --- Future payment provider (unused in V1) ---
PAYMENT_PROVIDER=MANUAL_WHATSAPP
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
